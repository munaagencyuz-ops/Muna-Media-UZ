# Cloudflare Pages → Settings → Environment variables
SANITY_PROJECT_ID=jin43s4b
SANITY_DATASET=production
SANITY_API_VERSION=2025-01-01
SANITY_API_TOKEN=your_sanity_write_token

# Telegram notifications for website leads
# Create a Telegram bot via @BotFather, add it to your lead group/channel, then set these as Cloudflare Pages secrets.
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_telegram_chat_or_group_id

# Sanity Studio local development
SANITY_STUDIO_PROJECT_ID=jin43s4b
SANITY_STUDIO_DATASET=production


# Contact capture stays unavailable until the operator verifies a PRIVATE receiver dataset.
# Never point this at an unverified/public content dataset; do not seed production data.
SANITY_LEAD_DATASET=your_verified_private_dataset
SANITY_LEAD_DATASET_PRIVATE=false
# Optional overrides; otherwise existing SANITY_PROJECT_ID / SANITY_API_TOKEN are reused.
# SANITY_LEAD_PROJECT_ID=your_receiver_project
# SANITY_LEAD_API_TOKEN=your_receiver_write_token

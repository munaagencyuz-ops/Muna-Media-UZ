{
  "name": "muna-media-uz",
  "version": "1.0.0",
  "description": "Muna Media website",
  "private": true,
  "scripts": {
    "dev": "http-server -p 3005 -c-1",
    "build:bundles": "node scripts/build-bundles.cjs",
    "build": "npm run build:bundles && node scripts/stage-public.cjs",
    "test": "node --test tests/*.test.cjs",
    "preview": "wrangler pages dev dist --compatibility-date=2025-01-01",
    "deploy": "npm run build && npm test && wrangler pages deploy dist --project-name=muna-media-uz"
  },
  "engines": {
    "node": ">=20.9.0"
  },
  "devDependencies": {
    "esbuild": "0.27.3",
    "http-server": "^14.1.1",
    "wrangler": "^4.0.0"
  }
}
